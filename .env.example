# ============================================
# GYDI Backend - Environment Variables Template
# ============================================
# Copy this file to .env.local for local development
# NEVER commit .env.local to git (it's in .gitignore)
#
# Generate secrets using commands provided in comments
# See ENVIRONMENT_STRATEGY.md for detailed documentation
# ============================================

# ============================================
# Spring Boot Profile
# ============================================
# Options: local, dev, staging, prod
SPRING_PROFILES_ACTIVE=local

# ============================================
# Database Configuration
# ============================================
# Local PostgreSQL (Option 1)
DATABASE_URL=jdbc:postgresql://localhost:5432/gydidb?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# Supabase Dev (Option 2 - shared with dev environment)
# DATABASE_URL=jdbc:postgresql://***REMOVED***:6543/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=***REMOVED***

# ============================================
# Security & Encryption
# ============================================
# JWT Secret (64+ characters, base64)
# Generate: openssl rand -base64 64
JWT_SECRET=LOCAL_DEV_SECRET_CHANGE_ME_AT_LEAST_64_CHARS_XXXXXXXXXXXXXXXXXX

# JWT Refresh Secret
JWT_REFERRAL_SECRET=LOCAL_REFERRAL_SECRET_ALSO_64_CHARS_XXXXXXXXXXXXXXXXXXX

# AES Secret Key (exactly 64 hex characters = 256 bits)
# Generate: openssl rand -hex 32
AES_SECRET_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Hashids Salt (32+ characters, base64)
# Generate: openssl rand -base64 32
URL_HASHIDS_SALT=local-dev-hashids-salt-32-chars

# ============================================
# Cloud Services
# ============================================
# Cloudinary (optional for local, use local storage if not set)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Storage Provider (local or cloudinary)
STORAGE_PROVIDER=local

# ============================================
# Email Service
# ============================================
# Resend API Key (optional for local, logs to console if not set)
RESEND_API_KEY=re_123456789_test_key
RESEND_FROM_EMAIL=dev@gydi.local

# Email Provider (console, resend)
EMAIL_PROVIDER=console

# Gmail SMTP (alternative for testing)
# GMAIL_USERNAME=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# ============================================
# Stripe Payment (Test Keys)
# ============================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_secret_placeholder
STRIPE_CURRENCY=USD

# ============================================
# Application Configuration
# ============================================
# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Server Port (default: 8080)
SERVER_PORT=8080

# ============================================
# Logging
# ============================================
# Log Level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=DEBUG

# SQL Logging
SQL_LOG_LEVEL=DEBUG

# Health Details (always, when-authorized, never)
HEALTH_DETAILS=always

# ============================================
# Feature Flags (Local - All enabled for testing)
# ============================================
FEATURE_ML_RECOMMENDATIONS=true
FEATURE_REFERRAL_ANALYTICS=true
FEATURE_NEW_PAYMENT=true
FEATURE_AB_TESTING=true
FEATURE_MULTI_REGION=false

# ============================================
# Monitoring (Optional)
# ============================================
# Sentry DSN (leave empty for local)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================
# Dev Tools
# ============================================
# Dev Email Recipient (for testing emails)
DEV_EMAIL_RECIPIENT=dev@localhost
