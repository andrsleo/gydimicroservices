# ============================================
# GYDI Microservices - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (already in .gitignore)

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret:
#   openssl rand -base64 64
# Or online: https://www.grc.com/passwords.htm
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-this-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# Database Configuration
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/gydi_db
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# ============================================
# AWS Configuration (for production)
# ============================================
# SECURITY: Prefer IAM roles over access keys
#
# Option 1 (RECOMMENDED): Use IAM roles
#   - Attach IAM role with S3/SES permissions to EC2/ECS/Lambda
#   - No need to set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY
#   - DefaultCredentialsProvider will automatically discover the role
#
# Option 2: Use access keys (only for development/testing)
#   - Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY below
#   - Rotate keys regularly
#   - Never commit actual keys to git
AWS_ACCESS_KEY_ID=your-aws-access-key-only-for-dev
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-only-for-dev
AWS_REGION=us-east-1

# S3 Configuration
AWS_S3_BUCKET_NAME=gydi-property-images
AWS_S3_BASE_URL=https://gydi-property-images.s3.amazonaws.com

# SES Configuration (for email sending)
AWS_SES_FROM_EMAIL=noreply@gydi.com

# ============================================
# Email Configuration
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=noreply@gydi.com

# ============================================
# Application Configuration
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
